<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
	<string>Mission Planner</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>

	<!-- User data in Documents/ survives Sideloadly re-signs and is visible in the Files app -->
	<key>UIFileSharingEnabled</key>
	<true/>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>

	<!-- iPadOS 14+ local network prompt, needed for MAVLink over UDP 14550/14555 and TCP 5760 -->
	<key>NSLocalNetworkUsageDescription</key>
	<string>Mission Planner talks MAVLink to your vehicle over Wi-Fi (UDP 14550 / TCP 5760).</string>
	<key>NSBonjourServices</key>
	<array>
		<string>_mavlink._udp</string>
		<string>_mavlink._tcp</string>
	</array>

	<!-- BLE telemetry radios / UART bridges -->
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>Mission Planner connects to Bluetooth LE telemetry radios.</string>

	<!-- Landscape-only ground station. Landscape-only on iPad requires full screen
	     (Split View needs all four orientations). -->
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UIRequiresFullScreen</key>
	<true/>
	<key>UIDeviceFamily</key>
	<array>
		<integer>2</integer>
	</array>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
	</dict>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UIStatusBarHidden</key>
	<false/>
</dict>
</plist>
